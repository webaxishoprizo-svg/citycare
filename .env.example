# Central Clinic ERP API Configuration
# Local Development: points to ERP server (default port 8080)
# Production (Vercel): update to your deployed Cloudflare ERP domain (e.g. https://clinicai-erp.workers.dev/api/public/irisxe/v1)
VITE_ERP_API_URL=http://localhost:8080/api/public/irisxe/v1
VITE_ERP_API_KEY=replace_with_your_erp_api_key

